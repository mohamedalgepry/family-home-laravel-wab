APP_NAME="Family Home"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=UTC

# رابط الموقع الرسمي المستخدم عند توليد ملفات Prerender (يجب أن يكون HTTPS وبدون / في النهاية)
PRERENDER_BASE_URL=https://familyhome-co.com

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=family_home
DB_USERNAME=
DB_PASSWORD=

# Mandatory dedicated read-only DB account for AI Assistant (SELECT on projects & units only)
DB_READONLY_HOST=127.0.0.1
DB_READONLY_PORT=3306
DB_READONLY_DATABASE=family_home
DB_READONLY_USERNAME=
DB_READONLY_PASSWORD=

CACHE_STORE=database
# Optional: Use Redis for cache & rate limiting in production if available
# CACHE_STORE=redis
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=90
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

FILESYSTEM_DISK=local
TRUSTED_PROXIES=127.0.0.1

# AI Assistant Engine & LLM Configuration
# Supported providers: gemini (Google Gemini API), openrouter (OpenRouter API)
# The system auto-detects GEMINI_API_KEY if present, or OPENROUTER_API_KEY.
ASSISTANT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_FALLBACK_MODEL=google/gemini-2.0-flash-exp:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# AI Timeouts & Budgets (in seconds)
ASSISTANT_TOTAL_BUDGET_SECONDS=40.0
ASSISTANT_PER_REQUEST_TIMEOUT_SECONDS=30.0
